PORT=8080
# Local development: use a local Postgres URL with sslmode=disable.
# Render deployment: set this to the Render Postgres Internal Database URL in the Render dashboard.
DATABASE_URL=postgresql://postgres:password@localhost:5432/digital_stamp?sslmode=disable
FRONTEND_URL=http://localhost:3000

# Optional one-time bootstrap. Remove these values after the staff account exists.
# SEED_STAFF_NAME=Shop Owner
# SEED_STAFF_EMAIL=owner@example.com
# SEED_STAFF_PASSWORD=use-at-least-12-characters
