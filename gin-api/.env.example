PORT=8080
DATABASE_URL=mysql://app:app@127.0.0.1:3306/digital_stamp?ssl-mode=DISABLED
FRONTEND_URL=http://localhost:3000
COOKIE_SECURE=false

# Set all three values together only when creating the first staff account.
# Remove them after the account has been seeded successfully.
# SEED_STAFF_NAME=Shop Owner
# SEED_STAFF_EMAIL=owner@example.com
# SEED_STAFF_PASSWORD=replace-with-at-least-8-characters

# Optional CA certificate for verified production TLS.
# DATABASE_CA_CERT_FILE=/etc/secrets/aiven-ca.pem
